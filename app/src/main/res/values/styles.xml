--><resources>


    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">

    </style>

    <!-- Main app theme used after the splash screen dismisses. -->
    <style name="Theme.Vyze" parent="Theme.AppCompat.Light.NoActionBar">

    </style>

    <!-- Splash Screen theme — applied as the starting theme in the manifest.
         Off-white background matches the adaptive icon palette.
         Must be set BEFORE installSplashScreen() in the Activity. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vyze_foreground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_animated</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/vyze_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vyze</item>
    </style>

    <style name="AppThemeProgressStyle">
        <item name="colorAccent">@color/mp_variant</item>
    </style>
</resources>
