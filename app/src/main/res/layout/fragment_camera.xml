<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/camera_container_desc"
    android:importantForAccessibility="no">

    <!-- Camera preview feed — full screen, no tint -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/view_finder_desc"
        android:importantForAccessibility="no"
        app:scaleType="fillStart"/>

    <!-- 50/50 gesture overlay (TalkBack co-existence).
         Active ONLY while touch exploration is enabled (toggled from
         CameraFragment). Each half exposes its contentDescription to
         TalkBack and click/long-click handlers that fire the same verbs as
         the physical gesture map, so TalkBack's double-tap-to-activate has
         a clean target and never collides with the multi-tap gesture
         vocabulary underneath. -->
    <LinearLayout
        android:id="@+id/gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:importantForAccessibility="no">

        <View
            android:id="@+id/overlay_look"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/overlay_look_desc" />

        <View
            android:id="@+id/overlay_ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/overlay_ask_desc" />

    </LinearLayout>

    <!-- Minimal floating status bar — bottom center -->
    <FrameLayout
        android:id="@+id/status_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="12dp"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="#AA000000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:text="Initializing..."
            android:importantForAccessibility="yes" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
